// NotHackwaly_Ocamlearlybird.Ocamlearlybird@1.3.6 -- the final ocamlearlybird
// executable per slot.
//
// ocamlearlybird is the `earlybird` opam package's executable (dune public_name
// `ocamlearlybird`). It is built from source as a per-package opam closure:
// NotHackwaly_Ocamlearlybird.Ocamlearlybird.Closure@1.3.6 (the generated driver
// in Ocamlearlybird.Closure.values.jsonc) run-functions the generic
// CommonsLang_OCaml.Dk.OpamBuild rule for every package in earlybird's locked
// dependency closure, in topological order, so each opam package is its own
// content-addressed dk object and an interrupted build resumes from the
// completed objects. The closure's output is earlybird's own opam install
// prefix as install.zip.
//
// This thin form republishes that prefix's executable as bin/ocamlearlybird.
// The precommand extracts the closure's install.zip natively (dk0's built-in
// zip support, no external unzip) into ip/. earlybird installs the binary under
// the dune public_name `ocamlearlybird`, so the prefix carries
// bin/ocamlearlybird.exe on Windows and bin/ocamlearlybird on Unix; each slot
// copies its variant to the uniform output path bin/ocamlearlybird.exe.
{
  "$schema": "https://diskuv.com/dk/schema/dk-value-1.0.json",
  "schema_version": { "major": 1, "minor": 0 },
  "forms": [
    {
      "id": "NotHackwaly_Ocamlearlybird.Ocamlearlybird@1.3.6",
      "precommands": {
        "private": [
          "get-object NotHackwaly_Ocamlearlybird.Ocamlearlybird.Closure@1.3.6 -s ${SLOTNAME.request} -m ./install.zip -d ip"
        ]
      },
      "function": {
        "commands": [
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "mkdir", "-p", "${SLOT.request}/bin"
          ],
          // Per-slot copy, gated with the `env -u ${SLOT.Release.<slot>}` trick
          // (dk0 drops a command whose referenced slot is not the one being
          // built). Windows prefixes ship bin/ocamlearlybird.exe; Unix prefixes
          // ship bin/ocamlearlybird.
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Windows_x86_64}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird.exe", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Windows_x86}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird.exe", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Linux_x86_64}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Linux_x86_64_musl}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Linux_x86}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Linux_arm64}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Darwin_x86_64}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird", "${SLOT.request}/bin/ocamlearlybird.exe"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "env", "-u", "${SLOT.Release.Darwin_arm64}", "--",
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp", "ip/bin/ocamlearlybird", "${SLOT.request}/bin/ocamlearlybird.exe"
          ]
        ]
      },
      "outputs": {
        "assets": [
          { "slots": ["Release.Windows_x86_64"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Windows_x86"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Linux_x86_64"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Linux_x86_64_musl"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Linux_x86"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Linux_arm64"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Darwin_x86_64"], "paths": ["bin/ocamlearlybird.exe"] },
          { "slots": ["Release.Darwin_arm64"], "paths": ["bin/ocamlearlybird.exe"] }
        ]
      }
    }
  ]
}
