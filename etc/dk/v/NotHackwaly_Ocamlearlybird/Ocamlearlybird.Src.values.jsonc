// NotHackwaly_Ocamlearlybird.Ocamlearlybird.Src@1.3.6 -- the ocamlearlybird
// working tree as one content-addressed object, which the generic OpamBuild
// rule stages (get-object, via its localsrc= parameter) as the source for the
// one local (in-tree) package `earlybird`.
//
// The object carries two top-level members in every slot:
//   * output.zip           -- the buildable source tree under a single top
//                             directory earlybird-1.3.6/ (dune, dune-project,
//                             earlybird.opam, src/). OpamBuild fetches it with
//                             `get-object ... -m ./output.zip` and 7zz-extracts
//                             it into s/, then the build wrapper descends into
//                             the sole earlybird-1.3.6/ directory.
//   * dk-opam-lock.jsonc   -- the checked-in opam lock, copied verbatim so the
//                             per-package build reads exactly what the workspace
//                             carries (consume-from-archive: no second copy to
//                             keep in sync). OpamBuild fetches it with
//                             `get-object ... -m ./dk-opam-lock.jsonc`.
//
// The source pieces come from the dk.u workspace assets
// (NotHackwaly_Ocamlearlybird.Apparatus.*@1.3.6). Assembly is pure file copying
// (coreutils) plus a zip (S7z), so it is host-independent; each slot rebuilds an
// identical output.zip, which is acceptable for a copy-only step and mirrors
// CommonsBase_Dk.Dk0.MlFrontSource.
{
  "$schema": "https://diskuv.com/dk/schema/dk-value-1.0.json",
  "schema_version": { "major": 1, "minor": 0 },
  "forms": [
    {
      "id": "NotHackwaly_Ocamlearlybird.Ocamlearlybird.Src@1.3.6",
      // Extract the src/ directory asset into the assembly directory
      // earlybird-1.3.6/ at top level (execution phase); dk0 extracts natively.
      "precommands": {
        "private": [
          "get-asset NotHackwaly_Ocamlearlybird.Apparatus.Src@1.3.6 -p src -d earlybird-1.3.6"
        ]
      },
      "function": {
        "commands": [
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "mkdir", "-p", "${SLOT.request}"
          ],
          // Copy the three top-level project files into the assembly directory.
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp",
            "$(get-asset NotHackwaly_Ocamlearlybird.Apparatus.DuneRoot@1.3.6 -p dune -f dune)",
            "earlybird-1.3.6/dune"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp",
            "$(get-asset NotHackwaly_Ocamlearlybird.Apparatus.DuneProject@1.3.6 -p dune-project -f dune-project)",
            "earlybird-1.3.6/dune-project"
          ],
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp",
            "$(get-asset NotHackwaly_Ocamlearlybird.Apparatus.Opam@1.3.6 -p earlybird.opam -f earlybird.opam)",
            "earlybird-1.3.6/earlybird.opam"
          ],
          // A dune-workspace at the source root makes earlybird's own `dune
          // build`/`dune install` treat this tree as the workspace root, so it
          // cannot escape upward into sibling dk sandboxes under the consumer's
          // t/ (which would otherwise collide on a second copy of earlybird's
          // dune-project). The generic OpamBuild dune-workspace isolation covers
          // external packages; the local (localsrc) package supplies its own.
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp",
            "$(get-asset NotHackwaly_Ocamlearlybird.Apparatus.DuneWorkspace@1.3.6 -p dk-src/dune-workspace -f dune-workspace)",
            "earlybird-1.3.6/dune-workspace"
          ],
          // Emit the opam lock as a top-level object member (verbatim).
          [
            "$(get-object CommonsBase_Std.Coreutils@0.8.0 -s ${SLOTNAME.Release.execution_abi} -m ./coreutils.exe -f coreutils.exe -e '*')",
            "cp",
            "$(get-asset NotHackwaly_Ocamlearlybird.Apparatus.Lock@1.3.6 -p dk.opam-lock.jsonc -f lock.jsonc)",
            "${SLOT.request}/dk-opam-lock.jsonc"
          ],
          // Package the assembled tree (single earlybird-1.3.6/ top level) as
          // output.zip.
          [
            "$(get-object CommonsBase_Std.S7z@25.1.0 -s Release.execution_abi -e '*' -d :)/7zz.exe",
            "a", "-tzip", "${SLOT.request}/output.zip", "./earlybird-1.3.6"
          ]
        ]
      },
      "outputs": {
        "assets": [
          {
            "slots": [
              "Release.Windows_x86_64", "Release.Windows_x86",
              "Release.Linux_x86_64", "Release.Linux_x86_64_musl",
              "Release.Linux_x86", "Release.Linux_arm64",
              "Release.Darwin_x86_64", "Release.Darwin_arm64"
            ],
            "paths": [ "output.zip", "dk-opam-lock.jsonc" ]
          }
        ]
      }
    }
  ]
}
